class Solution {
    public int longestIncreasingPath(int[][] matrix) {
        if (matrix == null || matrix.length == 0) return 0;
        int m = matrix.length, n = matrix[0].length;
        int[][] memo = new int[m][n];
        int maxLen = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                maxLen = Math.max(maxLen, dfs(matrix, i, j, m, n, memo, -1));
            }
        }
        return maxLen;
    }

    private int dfs(int[][] matrix, int i, int j, int m, int n, int[][] memo, int prevValue) {
        if (i < 0 || j < 0 || i >= m || j >= n || matrix[i][j] <= prevValue) return 0;
        if (memo[i][j] != 0) return memo[i][j];

        int left = dfs(matrix, i, j - 1, m, n, memo, matrix[i][j]);
        int right = dfs(matrix, i, j + 1, m, n, memo, matrix[i][j]);
        int up = dfs(matrix, i - 1, j, m, n, memo, matrix[i][j]);
        int down = dfs(matrix, i + 1, j, m, n, memo, matrix[i][j]);

        memo[i][j] = 1 + Math.max(Math.max(left, right), Math.max(up, down));
        return memo[i][j];
    }
}
